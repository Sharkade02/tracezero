<UserControl x:Class="TraceZero.App.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:PrivacyViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Privacy.Headline}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Privacy.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Privacy.Analyze}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding InspectCommand}" MinWidth="170" />
                    <Button Content="{DynamicResource Privacy.CleanSelected}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CleanCommand}" Margin="10,0,0,0" MinWidth="220" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Text="{DynamicResource Privacy.Warning}" />
            </StackPanel>
        </Border>

        <!-- Liste des traces -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"
                Visibility="{Binding HasTraces, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Traces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" Margin="2" CornerRadius="8"
                                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding CanSelect}"
                                              VerticalAlignment="Top" Margin="0,2,12,0"
                                              AutomationProperties.Name="{Binding DisplayName}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Subtle}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Subtle}"
                                                   FontStyle="Italic" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="6" Padding="8,3" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Risk.Safe}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Résultat -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Bottom" Margin="0,12,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>

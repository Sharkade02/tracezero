<UserControl x:Class="TraceZero.App.Views.DiskSpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:DiskSpaceViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Espace disque" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="Occupation de vos lecteurs et recherche des fichiers volumineux dans votre dossier personnel." />
        </StackPanel>

        <!-- Lecteurs -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="15" />
                                <TextBlock Text="{Binding Format}" Style="{StaticResource Text.Subtle}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="10" Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}"
                                         Margin="0,8,0,6" Foreground="{DynamicResource Brush.Accent}"
                                         Background="{DynamicResource Brush.Control.Hover}" BorderThickness="0" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Subtle}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Recherche de gros fichiers -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fichiers volumineux" Style="{StaticResource Text.Title}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox ItemsSource="{Binding Thresholds}" SelectedItem="{Binding SelectedThreshold}"
                              DisplayMemberPath="Label" Width="160" VerticalAlignment="Center" />
                    <Button Content="Analyser" Style="{StaticResource PrimaryButton}" Command="{Binding ScanLargeFilesCommand}"
                            Margin="12,0,0,0" MinWidth="120" />
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                            Margin="8,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Envoyer la sélection à la Corbeille" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RecycleSelectedCommand}" Margin="8,0,0,0"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Résultats -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LargeFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                          Margin="0,0,12,0" AutomationProperties.Name="{Binding FileName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Subtle}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Text.Subtle}"
                                           VerticalAlignment="Center" Margin="12,0" />
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"
                                           MinWidth="80" TextAlignment="Right" />
                                <Button Grid.Column="4" Content="Ouvrir" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                        Margin="12,0,0,0"
                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

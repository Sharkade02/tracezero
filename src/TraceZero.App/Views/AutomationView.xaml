<UserControl x:Class="TraceZero.App.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:AutomationViewModel}">

    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
    </UserControl.Resources>

    <Grid Margin="32" MaxWidth="760" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Automatisation" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Planifiez un nettoyage automatique, sans service permanent. Il s'exécute via le Planificateur de tâches Windows. Aucun élément « à vérifier » n'est nettoyé automatiquement." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Profil" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                <RadioButton GroupName="Profile" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumMatch}, ConverterParameter=Safe}">
                    <StackPanel>
                        <TextBlock Text="Sûr" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="Caches et fichiers temporaires uniquement." Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Profile" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumMatch}, ConverterParameter=Privacy}">
                    <StackPanel>
                        <TextBlock Text="Confidentialité" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="Ajoute les traces autorisées (caches + confidentialité)." Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Déclencheur" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                <RadioButton GroupName="Trigger" Content="Chaque semaine" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedTrigger, Converter={StaticResource EnumMatch}, ConverterParameter=Weekly}" />
                <RadioButton GroupName="Trigger" Content="Chaque mois" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedTrigger, Converter={StaticResource EnumMatch}, ConverterParameter=Monthly}" />
                <RadioButton GroupName="Trigger" Content="À l'ouverture de session" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedTrigger, Converter={StaticResource EnumMatch}, ConverterParameter=AtLogon}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Activer le nettoyage automatique" IsChecked="{Binding IsEnabled}"
                          Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                <Button Content="Appliquer" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                        Margin="20,0,0,0" MinWidth="130" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>

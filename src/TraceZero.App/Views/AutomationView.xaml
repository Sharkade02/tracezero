<UserControl x:Class="TraceZero.App.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:AutomationViewModel}">

    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
    </UserControl.Resources>

    <Grid Margin="32" MaxWidth="760" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Nav.Automation}" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Automation.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Automation.Profile}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                <RadioButton GroupName="Profile" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumMatch}, ConverterParameter=Safe}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Automation.Safe}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{DynamicResource Automation.SafeHint}" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Profile" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumMatch}, ConverterParameter=Privacy}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Risk.Privacy}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{DynamicResource Automation.PrivacyHint}" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Automation.Trigger}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                <RadioButton GroupName="Trigger" Content="{DynamicResource Automation.Weekly}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedTrigger, Converter={StaticResource EnumMatch}, ConverterParameter=Weekly}" />
                <RadioButton GroupName="Trigger" Content="{DynamicResource Automation.Monthly}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedTrigger, Converter={StaticResource EnumMatch}, ConverterParameter=Monthly}" />
                <RadioButton GroupName="Trigger" Content="{DynamicResource Automation.AtLogon}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"
                             IsChecked="{Binding SelectedTrigger, Converter={StaticResource EnumMatch}, ConverterParameter=AtLogon}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource Automation.Enable}" IsChecked="{Binding IsEnabled}"
                          Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                <Button Content="{DynamicResource Automation.Apply}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                        Margin="20,0,0,0" MinWidth="130" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.NtfsAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:NtfsAnalysisViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Nav.Ntfs}" Style="{StaticResource Text.Headline}" />
                <Border Background="{DynamicResource Brush.Nav.Selected.Background}" CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Center" Margin="12,4,0,0">
                    <TextBlock Text="{DynamicResource Ntfs.ExpertMode}" FontSize="12" Foreground="{DynamicResource Brush.Nav.Selected.Foreground}" />
                </Border>
                <Button Content="{DynamicResource Common.Refresh}" Style="{StaticResource SecondaryButton}" Padding="12,6"
                        Command="{Binding RefreshCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Ntfs.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Artifacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="10,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" CornerRadius="4" Padding="9,3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMitigable}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="{DynamicResource Ntfs.GoErase}" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding DataContext.GoToSecureEraseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Visibility="{Binding IsMitigable, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

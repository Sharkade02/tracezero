<UserControl x:Class="TraceZero.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Home.Headline}"
                           Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource Home.Subtitle}" />
            </StackPanel>

            <!-- Carte principale : Health Check -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.Subtle}" Text="{DynamicResource Home.Recoverable}" />
                        <TextBlock Text="{Binding RecoverableText}" FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,4" />

                        <TextBlock Text="{DynamicResource Home.NoScan}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding DriveSummaryText}" Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{DynamicResource Risk.Safe}" Foreground="{DynamicResource Brush.Risk.Safe}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding SafeText}" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{DynamicResource Risk.Privacy}" Foreground="{DynamicResource Brush.Risk.Privacy}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Risk.Review}" Foreground="{DynamicResource Brush.Risk.Review}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding ReviewText}" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Action.Analyze}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding HealthCheckCommand}" MinWidth="180" />
                        <TextBlock Text="{DynamicResource Common.Analyzing}" Style="{StaticResource Text.Subtle}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{DynamicResource Action.Clean}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenCleanupCommand}" MinWidth="180" Margin="0,10,0,0"
                                Visibility="{Binding HasCleanable, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,10,0,0" TextAlignment="Center" MaxWidth="180" TextWrapping="Wrap"
                                   Text="{DynamicResource Home.AnalyzeHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cartes secondaires : valeurs réelles après Health Check -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.Card.WinTemp}" Style="{StaticResource Text.Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WinTempText}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.Browsers}" Style="{StaticResource Text.Title}" FontSize="14" />
                        <TextBlock Text="{Binding BrowsersText}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.Card.RecycleBin}" Style="{StaticResource Text.Title}" FontSize="14" />
                        <TextBlock Text="{Binding RecycleBinText}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.Card.WinTraces}" Style="{StaticResource Text.Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WinTracesText}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bandeau confidentialité -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.Privacy.Title}" Style="{StaticResource Text.Title}" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                               Text="{DynamicResource Home.Privacy.Body}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

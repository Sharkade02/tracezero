<UserControl x:Class="TraceZero.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Home.Headline}"
                           Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource Home.Subtitle}" />
            </StackPanel>

            <!-- Carte principale : état non analysé (aucune valeur inventée) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.Subtle}" Text="{DynamicResource Home.Recoverable}" />
                        <TextBlock Text="—" FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,4" />
                        <TextBlock Style="{StaticResource Text.Subtle}" Text="{DynamicResource Home.NoScan}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{DynamicResource Risk.Safe}" Foreground="{DynamicResource Brush.Risk.Safe}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="—" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{DynamicResource Risk.Privacy}" Foreground="{DynamicResource Brush.Risk.Privacy}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="—" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Risk.Review}" Foreground="{DynamicResource Brush.Risk.Review}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="—" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Action.Analyze}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AnalyzeCommand}" MinWidth="180" />
                        <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,10,0,0"
                                   TextAlignment="Center" MaxWidth="180" TextWrapping="Wrap"
                                   Text="{DynamicResource Home.AnalyzeHint}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cartes secondaires -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.Card.WinTemp}" Style="{StaticResource Text.Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.Browsers}" Style="{StaticResource Text.Title}" FontSize="14" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.Card.RecycleBin}" Style="{StaticResource Text.Title}" FontSize="14" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.Card.WinTraces}" Style="{StaticResource Text.Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bandeau honnêteté -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.Privacy.Title}" Style="{StaticResource Text.Title}" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                               Text="{DynamicResource Home.Privacy.Body}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

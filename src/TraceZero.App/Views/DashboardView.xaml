<UserControl x:Class="TraceZero.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Votre PC peut être nettoyé en toute sécurité"
                           Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="TraceZero analyse votre système localement : fichiers temporaires, traces de navigateurs, Corbeille et traces d'activité Windows — en protégeant votre vie privée." />
            </StackPanel>

            <!-- Carte principale : état non analysé (aucune valeur inventée) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.Subtle}" Text="Espace récupérable" />
                        <TextBlock Text="—" FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,4" />
                        <TextBlock Style="{StaticResource Text.Subtle}"
                                   Text="Aucune analyse effectuée. Lancez une analyse pour voir l'espace récupérable." />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Sans risque" Foreground="{DynamicResource Brush.Risk.Safe}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="—" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Confidentialité" Foreground="{DynamicResource Brush.Risk.Privacy}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="—" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="À vérifier" Foreground="{DynamicResource Brush.Risk.Review}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="—" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Analyser mon PC" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AnalyzeCommand}" MinWidth="180" />
                        <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,10,0,0"
                                   TextAlignment="Center" MaxWidth="180" TextWrapping="Wrap"
                                   Text="Ouvre la page Nettoyage et lance une analyse réelle de votre PC." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cartes secondaires -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Windows temporaires" Style="{StaticResource Text.Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Navigateurs" Style="{StaticResource Text.Title}" FontSize="14" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Corbeille" Style="{StaticResource Text.Title}" FontSize="14" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Traces Windows" Style="{StaticResource Text.Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="—" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bandeau honnêteté Phase 0 -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Phase 0 — Fondations" Style="{StaticResource Text.Title}" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                               Text="La coquille, la navigation, les thèmes et la couche de sécurité (validation des chemins) sont en place. Le scan et le nettoyage réels arrivent aux phases suivantes. Aucune valeur affichée n'est simulée." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

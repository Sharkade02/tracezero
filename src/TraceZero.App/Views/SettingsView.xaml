<UserControl x:Class="TraceZero.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Paramètres" Style="{StaticResource Text.Headline}" Margin="0,0,0,16" />

        <!-- Apparence -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Apparence" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10" />
                <CheckBox Content="Thème sombre" IsChecked="{Binding IsDarkTheme}"
                          Foreground="{DynamicResource Brush.Text.Primary}" />
            </StackPanel>
        </Border>

        <!-- Exclusions -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Exclusions" Style="{StaticResource Text.Title}" FontSize="15" />
                    <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="Les dossiers exclus ne seront jamais proposés au nettoyage, même s'ils contiennent des fichiers correspondant à une règle." />
                    <Button Content="Ajouter un dossier…" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Exclusions}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="8"
                                    Background="{DynamicResource Brush.Control.Hover}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="5"
                                            Padding="7,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <Button Grid.Column="2" Content="Retirer" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

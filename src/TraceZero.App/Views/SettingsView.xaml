<UserControl x:Class="TraceZero.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Settings.Title}" Style="{StaticResource Text.Headline}" Margin="0,0,0,16" />

        <!-- Apparence + langue -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10" />
                <CheckBox Content="{DynamicResource Settings.DarkMode}" IsChecked="{Binding IsDarkTheme}"
                          Foreground="{DynamicResource Brush.Text.Primary}" />

                <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,16,0,6" />
                <ComboBox Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Display"
                          AutomationProperties.Name="{DynamicResource Settings.Language}" />
                <TextBlock Text="{DynamicResource Settings.LanguageHint}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Nettoyage avancé (élévation, Phase 20) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.AdvancedCleaning}" Style="{StaticResource Text.Title}"
                           FontSize="15" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="{DynamicResource Settings.AdvCleanBody}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Settings.CleanWindowsTemp}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CleanWindowsTempCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ElevatedStatus}" Style="{StaticResource Text.Subtle}"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Exclusions -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{DynamicResource Settings.Exclusions}" Style="{StaticResource Text.Title}" FontSize="15" />
                    <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="{DynamicResource Settings.ExclusionsHint}" />
                    <Button Content="{DynamicResource Settings.AddFolder}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Exclusions}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="8"
                                    Background="{DynamicResource Brush.Control.Hover}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="5"
                                            Padding="7,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <Button Grid.Column="2" Content="{DynamicResource Common.Remove}" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.DriverHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:DriverHealthViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Pilotes" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Inventaire en lecture seule de vos pilotes. TraceZero n'installe ni ne télécharge aucun pilote : les mises à jour passent par Windows Update, jamais par une base tierce." />
        </StackPanel>

        <!-- Mises à jour : délégué à Windows Update (§24) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Mise à jour des pilotes" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Style="{StaticResource Text.Subtle}" FontSize="12" TextWrapping="Wrap"
                               Text="Pour rester sûr, l'installation de pilotes est confiée à Windows Update (pilotes signés, compatibles, réversibles)." />
                </StackPanel>
                <Button Grid.Column="1" Content="Ouvrir Windows Update" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Command="{Binding OpenWindowsUpdateCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Rechercher un pilote (périphérique, fournisseur, classe)"
                         AutomationProperties.Name="Rechercher un pilote" />
                <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="Analyse…" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <!-- Squelette de chargement (WMI = latence réelle) -->
                <ItemsControl Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Focusable="False" Margin="10,7">
                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type sys:Double}">
                            <sys:Double>320</sys:Double>
                            <sys:Double>260</sys:Double>
                            <sys:Double>300</sys:Double>
                            <sys:Double>240</sys:Double>
                            <sys:Double>290</sys:Double>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,9">
                                <Border Style="{StaticResource Skeleton}" Width="{Binding}" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource Skeleton}" Width="140" Height="10" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Drivers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Subtle}" FontSize="11">
                                            <Run Text="{Binding Provider, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding DeviceClass, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Text.Subtle}"
                                               VerticalAlignment="Center" Margin="10,0" MinWidth="90" />
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Text.Subtle}"
                                               VerticalAlignment="Center" Margin="10,0" MinWidth="80" />
                                    <Border Grid.Column="3" CornerRadius="4" Padding="9,3" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Control.Hover}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.SupporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SupporterViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Supporter.Headline}" Style="{StaticResource Text.Headline}" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource Supporter.Subtitle}" />
            </StackPanel>

            <!-- Statut -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Title}" FontSize="15" TextWrapping="Wrap" />
            </Border>

            <!-- Montants -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Supporter.Donate}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Tiers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="4" Height="70"
                                        Command="{Binding DataContext.ContributeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Recommended}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Supporter.Recommended}" FontSize="11" HorizontalAlignment="Center"
                                                   Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource Supporter.OtherAmount}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenOtherAmountCommand}" HorizontalAlignment="Left" Margin="4,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Activation -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Supporter.HaveCode}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="{DynamicResource Supporter.CodeHint}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="380" VerticalAlignment="Center" Text="{Binding LicenseInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource Supporter.HaveCode}" />
                        <Button Content="{DynamicResource Supporter.Activate}" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateCommand}" Margin="10,0,0,0" />
                        <Button Content="{DynamicResource Supporter.Deactivate}" Style="{StaticResource SecondaryButton}" Command="{Binding DeactivateCommand}"
                                Margin="8,0,0,0" Visibility="{Binding IsSupporter, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActivationMessage}" Style="{StaticResource Text.Subtle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Avantages -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Supporter.UnlocksTitle}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                               Text="{DynamicResource Supporter.UnlocksBody}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:RestoreViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Restauration" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="Restaurer les éléments disponibles. Les traces de confidentialité sont sauvegardées avant d'être effacées." />
        </StackPanel>

        <!-- Protection du nettoyage -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Protection du nettoyage" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Avant chaque nettoyage réversible, TraceZero sauvegarde localement ce qui peut l'être (clés de registre des traces de confidentialité). Ces sauvegardes restent sur votre PC et ne sont jamais transmises. Un fichier effacé de façon sécurisée ne peut pas être restauré — cela n'est jamais promis." />
            </StackPanel>
        </Border>

        <!-- Barre de statut -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
        </Border>

        <!-- Liste -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,8,10">
                    <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="Vider le coffre" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Margin="8,4"
                           Text="Aucun élément à restaurer pour le moment.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource Text.Subtle}"
                                               VerticalAlignment="Center" MinWidth="130" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Subtle}" FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0"
                                            Background="{DynamicResource Brush.Risk.Safe}" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding ReversibilityText}" FontSize="12" Foreground="White" />
                                    </Border>
                                    <Button Grid.Column="3" Content="Restaurer" Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Nav.About}" Style="{StaticResource Text.Headline}" />
                <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource About.Subtitle}" />
            </StackPanel>

            <!-- Identité produit -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="TraceZero" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{DynamicResource About.Tagline}" Style="{StaticResource Text.Subtle}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Subtle}" Margin="0,10,0,0" />
                    <TextBlock Text="{DynamicResource About.License}" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
            </Border>

            <!-- Avertissement -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.DisclaimerTitle}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource About.DisclaimerBody}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Confidentialité (résumé) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.PrivacyTitle}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource About.PrivacyBody}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Documents légaux -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.LegalTitle}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="{DynamicResource About.OpenRepo}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,10,10" Command="{Binding OpenRepoCommand}" />
                        <Button Content="{DynamicResource About.OpenLicense}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,10,10" Command="{Binding OpenLicenseCommand}" />
                        <Button Content="{DynamicResource About.OpenPrivacy}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,10,10" Command="{Binding OpenPrivacyCommand}" />
                        <Button Content="{DynamicResource About.OpenDisclaimer}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,10,10" Command="{Binding OpenDisclaimerCommand}" />
                        <Button Content="{DynamicResource About.OpenNotices}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,10,10" Command="{Binding OpenNoticesCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

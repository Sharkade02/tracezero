<UserControl x:Class="TraceZero.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:CleanupViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Puce de risque colorée selon le niveau. -->
        <Style x:Key="RiskChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Safe}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="Privacy">
                    <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="Review">
                    <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Nettoyage" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="Analysez votre PC, choisissez ce qui doit être supprimé, puis nettoyez. Chaque suppression est validée par la couche de sécurité." />
        </StackPanel>

        <!-- Barre d'action -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Analyser mon PC" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" MinWidth="160" />
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Margin="10,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                             IsIndeterminate="{Binding IsScanning}"
                             Margin="0,12,0,0" Foreground="{DynamicResource Brush.Accent}"
                             Background="{DynamicResource Brush.Control.Hover}" BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Résumé + prévisualisation (quand des éléments existent) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.Subtle}" Text="Sélection à nettoyer" />
                    <TextBlock Text="{Binding SelectedBytesText}" FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Sans risque " Foreground="{DynamicResource Brush.Risk.Safe}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding SafeBytesText}" Style="{StaticResource Text.Subtle}" Margin="0,0,16,0" />
                        <TextBlock Text="Confidentialité " Foreground="{DynamicResource Brush.Risk.Privacy}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding PrivacyBytesText}" Style="{StaticResource Text.Subtle}" Margin="0,0,16,0" />
                        <TextBlock Text="À vérifier " Foreground="{DynamicResource Brush.Risk.Review}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding ReviewBytesText}" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Nettoyer maintenant" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CleanCommand}" VerticalAlignment="Center" MinWidth="180" />
            </Grid>
        </Border>

        <!-- Liste des éléments -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="2" CornerRadius="8"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              AutomationProperties.Name="{Binding DisplayName}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource RiskChip}" Margin="12,0">
                                        <TextBlock Text="{Binding RiskLabel}" Foreground="White"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="90">
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Subtle}"
                                                   HorizontalAlignment="Right" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- État vide après analyse -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Rien à nettoyer" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                           Text="Aucun élément récupérable n'a été trouvé pour le moment. C'est bon signe !" />
            </StackPanel>
        </Border>

        <!-- Message de résultat -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Bottom" Margin="0,12,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Résultat du nettoyage" Style="{StaticResource Text.Title}" FontSize="14" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

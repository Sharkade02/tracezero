<UserControl x:Class="TraceZero.App.Views.SecureEraseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SecureEraseViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Effacement sécurisé" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Rendez des fichiers irrécupérables, ou effacez l'espace libre d'un lecteur. Sur SSD/NVMe, aucun effacement n'est présenté comme garanti — l'avertissement est honnête." />
        </StackPanel>

        <!-- Effacement de fichiers -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Fichiers à effacer" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Ajouter des fichiers…" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" />
                    <Button Content="Vider la liste" Style="{StaticResource SecondaryButton}" Command="{Binding ClearTargetsCommand}" Margin="8,0,0,0" />
                    <CheckBox Content="Mode renforcé (3 passes)" IsChecked="{Binding Reinforced}" VerticalAlignment="Center" Margin="16,0,0,0"
                              Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileMediaWarning}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource Brush.Risk.Privacy}" FontSize="12"
                           Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}" />

                <Button DockPanel.Dock="Bottom" Content="Effacer définitivement" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Command="{Binding EraseCommand}"
                        Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Ajoutez des fichiers à effacer. Les fichiers système et les dossiers sont refusés. Opération irréversible.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTargets}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Subtle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Effacement de l'espace libre -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Effacer l'espace libre d'un lecteur" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Rend irrécupérables les fichiers déjà supprimés. Vos fichiers existants ne sont jamais touchés." />

                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="320" VerticalAlignment="Center" ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display"
                              AutomationProperties.Name="Lecteur dont effacer l'espace libre" />
                    <Button Content="Effacer l'espace libre" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Command="{Binding WipeFreeSpaceCommand}" />
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding CancelWipeCommand}"
                            Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Text="{Binding DriveMediaWarning}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource Brush.Risk.Privacy}" FontSize="12" />

                <ProgressBar Height="8" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="{Binding WipeProgress}"
                             Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="Progression de l'effacement de l'espace libre"
                             Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Control.Hover}" />
                <TextBlock Text="{Binding WipeStatus}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

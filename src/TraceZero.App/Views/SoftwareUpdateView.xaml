<UserControl x:Class="TraceZero.App.Views.SoftwareUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SoftwareUpdateViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Nav.Software}" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Software.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Software.Check}" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
                <Button Content="{DynamicResource Software.UpdateAll}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Command="{Binding UpdateAllCommand}"
                        Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{DynamicResource Common.Analyzing}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Updates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Subtle}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center" Margin="12,0"
                                           Foreground="{DynamicResource Brush.Risk.Safe}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="8,0" />
                                <Button Grid.Column="3" Content="{DynamicResource Software.Update}" Style="{StaticResource SecondaryButton}" Padding="12,4"
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:ApplicationsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Apps.Headline}" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="{DynamicResource Apps.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource Apps.Search}" AutomationProperties.Name="{DynamicResource Apps.Search}" />
                <Button Content="{DynamicResource Common.Refresh}" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding AppCountText}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="{DynamicResource Common.Loading}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Applications installées -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <!-- Squelette de chargement (Phase 1), pendant la lecture du registre. -->
                <ItemsControl Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                              Focusable="False" Margin="10,7">
                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type sys:Double}">
                            <sys:Double>320</sys:Double>
                            <sys:Double>260</sys:Double>
                            <sys:Double>300</sys:Double>
                            <sys:Double>230</sys:Double>
                            <sys:Double>290</sys:Double>
                            <sys:Double>250</sys:Double>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,9">
                                <Border Style="{StaticResource Skeleton}" Width="{Binding}"
                                        HorizontalAlignment="Left" />
                                <Border Style="{StaticResource Skeleton}" Width="140" Height="10"
                                        HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Subtle}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Text.Subtle}"
                                           VerticalAlignment="Center" Margin="10,0" MinWidth="70" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Text.Subtle}"
                                           VerticalAlignment="Center" Margin="10,0" MinWidth="70" TextAlignment="Right" />
                                <Button Grid.Column="3" Content="{DynamicResource Common.Open}" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="10,0,0,0"
                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="4" Content="{DynamicResource Apps.Uninstall}" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="8,0,0,0"
                                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Démarrage -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" MaxHeight="230">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Apps.Startup}" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StartupEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Text.Subtle}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LocationText}" Style="{StaticResource Text.Subtle}"
                                               VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="10,3" MinWidth="90"
                                            IsEnabled="{Binding CanToggle}"
                                            Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource Apps.Disable}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Text" Value="{DynamicResource Apps.Enable}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

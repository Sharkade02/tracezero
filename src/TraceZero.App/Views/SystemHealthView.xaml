<UserControl x:Class="TraceZero.App.Views.SystemHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SystemHealthViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Nav.SystemHealth}" Style="{StaticResource Text.Headline}" />
                <Button Content="{DynamicResource Common.Refresh}" Style="{StaticResource SecondaryButton}" Padding="12,6"
                        Command="{Binding RefreshCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Common.Analyzing}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource SystemHealth.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>

                <!-- Activité en direct (RAM + CPU) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemHealth.LiveLoad}" Style="{StaticResource Text.Title}" Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource Load.NoData}"
                                   Style="{StaticResource Text.Subtle}"
                                   Visibility="{Binding HasLiveLoad, Converter={StaticResource InvBoolToVis}}" />

                        <StackPanel Visibility="{Binding HasLiveLoad, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Load.CpuLabel}" MinWidth="90"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                                <Grid Grid.Column="1">
                                    <ProgressBar Maximum="100" Value="{Binding CpuPercent, Mode=OneWay}" Height="10"
                                                 BorderThickness="0"
                                                 Background="{DynamicResource Brush.Card.Border}"
                                                 Foreground="{DynamicResource Brush.Risk.Safe}" />
                                    <TextBlock Text="{Binding CpuPercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Load.MemoryLabel}" MinWidth="90"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                                <StackPanel Grid.Column="1">
                                    <ProgressBar Maximum="100" Value="{Binding MemoryUsedPercent, Mode=OneWay}" Height="10"
                                                 BorderThickness="0"
                                                 Background="{DynamicResource Brush.Card.Border}"
                                                 Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="{Binding MemoryUsedText}" Style="{StaticResource Text.Subtle}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Programmes les plus gourmands (mémoire) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemHealth.TopProcesses}" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Load.TopProcessesHint}" Style="{StaticResource Text.Subtle}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource Load.NoProcesses}"
                                   Style="{StaticResource Text.Subtle}"
                                   Visibility="{Binding HasTopProcesses, Converter={StaticResource InvBoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Subtle}" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Indice de performance Windows (WinSAT) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemHealth.PerfIndex}" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Perf.Note}" Style="{StaticResource Text.Subtle}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource Perf.NotAssessed}"
                                   Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                                   Visibility="{Binding HasPerfIndex, Converter={StaticResource InvBoolToVis}}" />

                        <StackPanel Visibility="{Binding HasPerfIndex, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Perf.Base}" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding PerfBaseScoreText}" FontSize="28" FontWeight="Bold" Margin="10,0,0,0"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>

                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource Perf.Cpu}" MinWidth="150" Style="{StaticResource Text.Subtle}" />
                                    <TextBlock Text="{Binding PerfCpuText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource Perf.Memory}" MinWidth="150" Style="{StaticResource Text.Subtle}" />
                                    <TextBlock Text="{Binding PerfMemoryText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource Perf.Disk}" MinWidth="150" Style="{StaticResource Text.Subtle}" />
                                    <TextBlock Text="{Binding PerfDiskText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource Perf.Graphics}" MinWidth="150" Style="{StaticResource Text.Subtle}" />
                                    <TextBlock Text="{Binding PerfGraphicsText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{DynamicResource Perf.Gaming}" MinWidth="150" Style="{StaticResource Text.Subtle}" />
                                    <TextBlock Text="{Binding PerfGamingText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Mémoire (RAM) physique -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemHealth.Memory}" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />

                        <TextBlock Text="{DynamicResource SystemHealth.NoMemory}"
                                   Style="{StaticResource Text.Subtle}"
                                   Visibility="{Binding HasMemory, Converter={StaticResource InvBoolToVis}}" />

                        <StackPanel Visibility="{Binding HasMemory, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MemorySummaryText}" Style="{StaticResource Text.Subtle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding XmpText}" Style="{StaticResource Text.Subtle}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Memory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Slot}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           MinWidth="80" Foreground="{DynamicResource Brush.Text.Primary}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="{Binding Model}" Foreground="{DynamicResource Brush.Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Text.Subtle}" FontSize="12">
                                                        <Run Text="{Binding TypeText, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding SpeedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding CapacityText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding VoltageText}" Style="{StaticResource Text.Subtle}" FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               Visibility="{Binding HasVoltage, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Santé disque -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemHealth.DiskHealth}" Style="{StaticResource Text.Title}" Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource SystemHealth.NoDisks}"
                                   Style="{StaticResource Text.Subtle}"
                                   Visibility="{Binding HasDisks, Converter={StaticResource InvBoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Style="{StaticResource Text.Subtle}" FontSize="12">
                                                        <Run Text="{Binding MediaText, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Text.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Healthy">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Risk.Safe}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Unhealthy">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource Brush.Risk.Privacy}" FontSize="12"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Impact au démarrage -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemHealth.StartupImpact}" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ImpactMessage}" Style="{StaticResource Text.Subtle}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Impacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SampleText}" Style="{StaticResource Text.Subtle}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ImpactText}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Risk.Privacy}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

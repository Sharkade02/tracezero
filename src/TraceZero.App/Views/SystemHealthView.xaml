<UserControl x:Class="TraceZero.App.Views.SystemHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             xmlns:conv="clr-namespace:TraceZero.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:SystemHealthViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Nav.SystemHealth}" Style="{StaticResource Text.Headline}" />
                <Button Content="{DynamicResource Common.Refresh}" Style="{StaticResource SecondaryButton}" Padding="12,6"
                        Command="{Binding RefreshCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Common.Analyzing}" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource SystemHealth.Subtitle}" />
        </StackPanel>

        <!-- Santé disque -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource SystemHealth.DiskHealth}" Style="{StaticResource Text.Title}" Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource SystemHealth.NoDisks}"
                           Style="{StaticResource Text.Subtle}"
                           Visibility="{Binding HasDisks, Converter={StaticResource InvBoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <TextBlock Style="{StaticResource Text.Subtle}" FontSize="12">
                                                <Run Text="{Binding MediaText, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Healthy">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Safe}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unhealthy">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Brush.Risk.Privacy}" FontSize="12"
                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Impact au démarrage -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource SystemHealth.StartupImpact}" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ImpactMessage}" Style="{StaticResource Text.Subtle}"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Impacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SampleText}" Style="{StaticResource Text.Subtle}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ImpactText}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Risk.Privacy}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

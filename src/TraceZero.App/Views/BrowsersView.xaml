<UserControl x:Class="TraceZero.App.Views.BrowsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:BrowsersViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Nav.Browsers}" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="{DynamicResource Browsers.Subtitle}" />
        </StackPanel>

        <!-- Bandeau protection des connexions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Browsers.Protected}" Style="{StaticResource Text.Title}" FontSize="15" />
                    <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource Browsers.ProtectedBody}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Browsers.CleanCaches}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CleanCachesCommand}" MinWidth="200" />
                    <Button Content="{DynamicResource Common.Refresh}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Liste des navigateurs -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top"
                Visibility="{Binding HasBrowsers, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Browsers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="22"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding ProfilesText}" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Risk.Safe}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- État vide -->
        <Border Grid.Row="2" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBrowsers}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource Text.Subtle}"
                       Text="{DynamicResource Browsers.Empty}" />
        </Border>
    </Grid>
</UserControl>

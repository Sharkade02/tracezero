<UserControl x:Class="TraceZero.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:DuplicatesViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Nav.Duplicates}" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="{DynamicResource Dup.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Thresholds}" SelectedItem="{Binding SelectedThreshold}"
                              DisplayMemberPath="Label" Width="160" VerticalAlignment="Center"
                              AutomationProperties.Name="{DynamicResource Dup.Subtitle}" />
                    <Button Content="{DynamicResource Dup.Scan}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" Margin="12,0,0,0" MinWidth="180" />
                    <Button Content="{DynamicResource Common.Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                            Margin="8,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
                    <Button Content="{DynamicResource Dup.KeepNewest}" Style="{StaticResource SecondaryButton}" Command="{Binding KeepNewestCommand}" />
                    <Button Content="{DynamicResource Dup.ClearSel}" Style="{StaticResource SecondaryButton}" Command="{Binding ClearSelectionCommand}" Margin="8,0,0,0" />
                    <Button Content="{DynamicResource Dup.RecycleSel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RecycleSelectedCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Subtle}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"
                Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,6" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource Brush.Control.Hover}">
                                <StackPanel>
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              AutomationProperties.Name="{Binding Path}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Subtle}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Text.Subtle}"
                                                               VerticalAlignment="Center" Margin="12,0" />
                                                    <Button Grid.Column="3" Content="{DynamicResource Common.Open}" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TraceZero.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Nav.History}" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Subtle}" Margin="0,4,0,0"
                       Text="{DynamicResource History.Subtitle}" />
        </StackPanel>

        <!-- Statistiques -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.TotalFreed}" Style="{StaticResource Text.Subtle}" />
                    <TextBlock Text="{Binding TotalFreedText}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Risk.Safe}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Count}" Style="{StaticResource Text.Subtle}" />
                    <TextBlock Text="{Binding CleanupCountText}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Last}" Style="{StaticResource Text.Subtle}" />
                    <TextBlock Text="{Binding LastCleanupText}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Liste -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,8,10">
                    <Button Content="{DynamicResource Common.Refresh}" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="{DynamicResource History.Clear}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Margin="8,4"
                           Text="{DynamicResource History.Empty}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource Text.Subtle}"
                                               VerticalAlignment="Center" MinWidth="130" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Subtle}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FreedText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Risk.Safe}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

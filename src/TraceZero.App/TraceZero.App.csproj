<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TraceZero.Domain\TraceZero.Domain.csproj" />
    <ProjectReference Include="..\TraceZero.Application\TraceZero.Application.csproj" />
    <ProjectReference Include="..\TraceZero.Engine\TraceZero.Engine.csproj" />
    <ProjectReference Include="..\TraceZero.Browsers\TraceZero.Browsers.csproj" />
    <ProjectReference Include="..\TraceZero.Windows\TraceZero.Windows.csproj" />
    <ProjectReference Include="..\TraceZero.Storage\TraceZero.Storage.csproj" />
    <ProjectReference Include="..\TraceZero.Persistence\TraceZero.Persistence.csproj" />
    <ProjectReference Include="..\TraceZero.Updater\TraceZero.Updater.csproj" />
    <!-- Helper élevé (Phase 20) : copié à côté de l'app (exe + dll + deps + runtimeconfig). -->
    <ProjectReference Include="..\TraceZero.Elevated\TraceZero.Elevated.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- Écran de démarrage natif WPF : affiché instantanément, fondu automatique à l'ouverture de la fenêtre. -->
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Icône embarquée dans l'exe : Explorateur, raccourci menu Démarrer, barre des tâches. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

</Project>

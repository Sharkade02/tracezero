<Window x:Class="TraceZero.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TraceZero.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="TraceZero" Height="760" Width="1200" MinHeight="640" MinWidth="1000"
        Icon="/TraceZero.App;component/Assets/logo.png"
        Background="{DynamicResource Brush.Window.Background}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Hôte de superposition : contenu, puis couche modale, puis pile de toasts. -->
    <Grid>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="0,16">

                <!-- Marque -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,4,20,20">
                    <Image Source="/TraceZero.App;component/Assets/logo.png" Width="30" Height="30"
                           Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TraceZero" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Zone basse : Soutenir + bascule de thème -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding FooterPages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="16" Width="26" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{DynamicResource Shell.ToggleTheme}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleThemeCommand}" Margin="12,8,12,0"
                            HorizontalContentAlignment="Left" />
                </StackPanel>

                <!-- Navigation principale -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PrimaryPages}"
                              KeyboardNavigation.TabNavigation="Cycle">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         CommandParameter="{Binding}"
                                         AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="16" Width="26" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Zone de contenu (avec bannière de mise à jour) -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Accent}" Padding="20,10"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent.Foreground}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="{DynamicResource Update.Download}" Style="{StaticResource SecondaryButton}"
                            Padding="14,6" Command="{Binding DownloadUpdateCommand}"
                            Foreground="{DynamicResource Brush.Accent.Foreground}" />
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="8,0,0,0"
                            Command="{Binding DismissUpdateCommand}" Foreground="{DynamicResource Brush.Accent.Foreground}"
                            AutomationProperties.Name="{DynamicResource Common.Close}" />
                </Grid>
            </Border>
            <ContentControl Content="{Binding Current}" Focusable="False" Margin="0" />
        </DockPanel>
    </Grid>

        <!-- Couche modale (confirmations) -->
        <Grid Background="{DynamicResource Brush.Overlay.Scrim}"
              Visibility="{Binding Dialog.HasActive, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="10">
            <Border Style="{StaticResource Card}" Width="460" MaxWidth="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    DataContext="{Binding Dialog.Active}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Subtle}"
                               TextWrapping="Wrap" Margin="0,10,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding CancelText}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}" MinWidth="110" IsCancel="True" />
                        <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                                Margin="10,0,0,0" MinWidth="110" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pile de toasts (coin bas-droit) -->
        <ItemsControl ItemsSource="{Binding Toasts.Items}" Panel.ZIndex="20"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,24,24" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" Margin="0,8,0,0" Padding="14,10" MinWidth="300" MaxWidth="400"
                            Background="{DynamicResource Brush.Card.Background}"
                            BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.20" Direction="270" />
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Risk.Safe}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Risk.Privacy}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Risk.Review}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Glyph}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" FontSize="14" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="✕" Style="{StaticResource SecondaryButton}"
                                    Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding DismissCommand}"
                                    AutomationProperties.Name="Fermer la notification" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</Window>

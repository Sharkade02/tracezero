<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette sombre. Mêmes clés que Light.xaml. -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#111827" />
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#1E293B" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#334155" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Risk.Safe" Color="#22C55E" />
    <SolidColorBrush x:Key="Brush.Risk.Privacy" Color="#F59E0B" />
    <SolidColorBrush x:Key="Brush.Risk.Review" Color="#EF4444" />
    <SolidColorBrush x:Key="Brush.Nav.Selected.Background" Color="#1E3A8A" />
    <SolidColorBrush x:Key="Brush.Nav.Selected.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#334155" />

    <!-- Superposition modale + squelette de chargement (Phase 1). -->
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#99000000" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#334155" />

</ResourceDictionary>

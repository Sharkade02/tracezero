<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- Français (fr-FR) — langue par défaut. Clés identiques dans toutes les langues. -->

    <s:String x:Key="App.Tagline">Voyez ce qui reste. Nettoyez ce que vous choisissez.</s:String>

    <s:String x:Key="Common.Refresh">Actualiser</s:String>
    <s:String x:Key="Common.Cancel">Annuler</s:String>
    <s:String x:Key="Common.Confirm">Confirmer</s:String>
    <s:String x:Key="Common.Add">Ajouter</s:String>
    <s:String x:Key="Common.Remove">Retirer</s:String>
    <s:String x:Key="Common.Close">Fermer</s:String>

    <s:String x:Key="Shell.ToggleTheme">Basculer le thème</s:String>

    <s:String x:Key="Settings.Title">Paramètres</s:String>
